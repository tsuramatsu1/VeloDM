<Window x:Class="VeloDM.App.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download File Info" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Background="White">
    <StackPanel Margin="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Address" Style="{StaticResource FieldLabel}"
                       ToolTip="http(s) URL, magnet link or path to a .torrent file" />
            <TextBox x:Name="UrlBox" Grid.Column="1" Grid.ColumnSpan="2" Padding="4" Margin="0,0,0,10"
                     TextChanged="UrlBox_TextChanged" />

            <TextBlock Grid.Row="1" Text="Category" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                      Margin="0,0,0,10" SelectionChanged="CategoryBox_SelectionChanged" />

            <TextBlock Grid.Row="2" Text="Save as" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Padding="4" Margin="0,0,0,10"
                     TextChanged="NameBox_TextChanged" />

            <TextBlock Grid.Row="3" Text="Folder" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FolderBox" Grid.Row="3" Grid.Column="1" Padding="4" Margin="0,0,6,10"
                     TextChanged="FolderBox_TextChanged" />
            <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Padding="10,3" Margin="0,0,0,10" Click="Browse_Click" />

            <TextBlock x:Name="ConnectionsLabel" Grid.Row="4" Text="Connections" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ConnectionsBox" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
        </Grid>

        <Border Background="{StaticResource SidebarBrush}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="InfoText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="540" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="_Start Download" Style="{StaticResource DialogButton}" IsDefault="True" Click="Start_Click" />
            <Button Content="Download _Later" Style="{StaticResource DialogButton}" Click="Later_Click"
                    ToolTip="Add to the queue without starting" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
