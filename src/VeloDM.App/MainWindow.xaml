<Window x:Class="VeloDM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VeloDM" Height="640" Width="1120" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource WindowBrush}" Padding="2">
            <MenuItem Header="_Tasks">
                <MenuItem Header="_Add new download…" InputGestureText="Ctrl+N" Click="AddUrl_Click" />
                <MenuItem Header="Add _torrent file…" InputGestureText="Ctrl+T" Click="AddTorrent_Click" />
                <MenuItem Header="Add _video from a web page…" Click="AddVideo_Click" />
                <MenuItem Header="Add _batch of URLs…" Click="AddBatch_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Downloads">
                <MenuItem Header="_Resume" Click="Resume_Click" />
                <MenuItem Header="_Pause" Click="Pause_Click" />
                <MenuItem Header="Stop _all" Click="StopAll_Click" />
                <Separator />
                <MenuItem Header="_Delete…" InputGestureText="Del" Click="Delete_Click" />
                <MenuItem Header="Delete _completed" Click="DeleteCompleted_Click" />
                <Separator />
                <MenuItem Header="Refresh download _address…" Click="RefreshAddress_Click" />
                <MenuItem Header="Speed _limit for selected…" Click="ItemSpeedLimit_Click" />
                <MenuItem Header="_Verify checksum…" Click="Checksum_Click" />
                <MenuItem Header="E_xtract here" Click="Extract_Click" />
                <MenuItem Header="Propert_ies / progress" Click="Properties_Click" />
                <Separator />
                <MenuItem x:Name="SpeedLimitMenu" Header="_Speed limiter" IsCheckable="True" Click="SpeedLimit_Click" />
                <MenuItem Header="_Options…" Click="Options_Click" />
            </MenuItem>
            <MenuItem Header="_Queue">
                <MenuItem Header="_Start queue" Click="StartQueue_Click" />
                <MenuItem Header="S_top queue" Click="StopQueue_Click" />
                <Separator />
                <MenuItem Header="_Add selected to queue" Click="AddToQueue_Click" />
                <MenuItem Header="_Remove selected from queue" Click="RemoveFromQueue_Click" />
                <Separator />
                <MenuItem Header="Sc_heduler…" Click="Scheduler_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Install _browser extension…" Click="InstallExtension_Click" />
                <MenuItem Header="Check for _updates…" Click="CheckUpdates_Click" />
                <MenuItem Header="_About VeloDM" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Click="AddUrl_Click" ToolTip="Add a new download (Ctrl+N)">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE710;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Add URL" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="AddTorrent_Click" ToolTip="Add a .torrent file (Ctrl+T). Magnet links can be pasted into Add URL.">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8F1;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Torrent" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Resume_Click" ToolTip="Resume selected">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE768;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Resume" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Pause_Click" ToolTip="Pause selected">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE769;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Pause" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="StopAll_Click" ToolTip="Stop every download">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71A;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Stop All" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Delete selected (Del)">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Delete" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="DeleteCompleted_Click" ToolTip="Remove all finished downloads from the list">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE894;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Delete Done" /></StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="6,4" />
                <Button Style="{StaticResource ToolButton}" Click="StartQueue_Click" ToolTip="Start the download queue">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE896;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Start Queue" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="StopQueue_Click" ToolTip="Stop the download queue">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE8FD;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Stop Queue" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="Scheduler_Click" ToolTip="Schedule the queue">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE787;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Scheduler" /></StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="6,4" />
                <Button Style="{StaticResource ToolButton}" Click="Options_Click" ToolTip="Options">
                    <StackPanel><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE713;" /><TextBlock Style="{StaticResource ToolLabel}" Text="Options" /></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource SidebarBrush}" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="QueueStatus" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="StatusLine" Foreground="{DynamicResource MutedBrush}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="CategoryList" Background="{DynamicResource SidebarBrush}" BorderThickness="0"
                     Padding="4,6" SelectionChanged="CategoryList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" Margin="{Binding Indent}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Column="2">
                <DataGrid x:Name="DownloadGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="30"
                          BorderThickness="0" Background="{DynamicResource WindowBrush}" AlternatingRowBackground="{DynamicResource AltRowBrush}" RowBackground="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
                          MouseDoubleClick="DownloadGrid_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Open" FontWeight="Bold" Click="Open_Click" />
                            <MenuItem Header="Open _folder" Click="OpenFolder_Click" />
                            <Separator />
                            <MenuItem Header="_Resume" Click="Resume_Click" />
                            <MenuItem Header="_Pause / stop seeding" Click="Pause_Click" />
                            <MenuItem Header="Re_download" Click="Redownload_Click" />
                            <MenuItem Header="Refresh download _address…" Click="RefreshAddress_Click"
                                      ToolTip="For links that have expired: use a new link and keep what is already downloaded" />
                            <MenuItem Header="Speed _limit for this download…" Click="ItemSpeedLimit_Click" />
                            <Separator />
                            <MenuItem Header="Add to _queue" Click="AddToQueue_Click" />
                            <MenuItem Header="Remove from q_ueue" Click="RemoveFromQueue_Click" />
                            <Separator />
                            <MenuItem Header="_Verify checksum…" Click="Checksum_Click" />
                            <MenuItem Header="E_xtract here" Click="Extract_Click" />
                            <MenuItem Header="_Copy address" Click="CopyUrl_Click" />
                            <MenuItem Header="_Delete…" Click="Delete_Click" />
                            <Separator />
                            <MenuItem Header="Propert_ies / progress" Click="Properties_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="File Name" Width="2*" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Url}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE783;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Paused">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE769;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Queued">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE823;" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource FaintBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="TotalSize" Width="90" />
                        <DataGridTemplateColumn Header="Progress" Width="150" SortMemberPath="Progress">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Height="16">
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" SortMemberPath="Status" Width="1.2*" />
                        <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" SortMemberPath="Speed" Width="95" />
                        <DataGridTextColumn Header="Time Left" Binding="{Binding EtaText}" Width="85" />
                        <DataGridTextColumn Header="Conn. / Peers" Binding="{Binding ConnectionsText}" Width="95" />
                        <DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded, StringFormat=g}" SortMemberPath="DateAdded" Width="135" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="44" Foreground="{DynamicResource TrackBorderBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No downloads here yet" FontSize="15" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,4" HorizontalAlignment="Center" />
                    <TextBlock Text="Click Add URL, copy a download link, or use the browser extension." Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
