<Window x:Class="VeloDM.App.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install the browser extension" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Text="Send browser downloads to VeloDM" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" Foreground="#5A6472"
                   Text="Browsers only let you add an extension from outside their store by hand, so this takes three clicks per browser. The folder path is already copied to your clipboard." />

        <TextBlock Style="{StaticResource FieldLabel}" Text="1.  Open your browser's extensions page" />
        <StackPanel x:Name="BrowserButtons" Margin="18,6,0,12" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="2.  Turn on Developer mode (a switch on that page)" Margin="0,0,0,12" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="3.  Click Load unpacked, paste this folder path and choose Select Folder" />
        <DockPanel Margin="18,6,0,0">
            <Button DockPanel.Dock="Right" Content="Open" Padding="12,3" Margin="6,0,0,0" Click="OpenFolder_Click" />
            <Button DockPanel.Dock="Right" Content="Copy" Padding="12,3" Margin="6,0,0,0" Click="Copy_Click" />
            <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="4,3" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#5A6472"
                   Text="You can reopen this window any time from Help → Install browser extension." />
        <Button Content="Done" Style="{DynamicResource DialogButton}" HorizontalAlignment="Right" Margin="0,14,0,0"
                IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
