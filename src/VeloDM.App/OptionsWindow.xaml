<Window x:Class="VeloDM.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="560" Height="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Style="{StaticResource DialogButton}" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
        </StackPanel>

        <TabControl x:Name="Tabs" Padding="14">
            <TabItem Header="General">
                <StackPanel>
                    <TextBlock Text="Default download folder" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0" Click="Browse_Click" />
                        <TextBox Text="{Binding DownloadFolder}" />
                    </DockPanel>
                    <CheckBox x:Name="RunAtStartupBox" Content="Start VeloDM when I sign in to Windows (hidden in the system tray)" />
                    <CheckBox Content="Save each category in its own subfolder (Video, Music, Programs…)" IsChecked="{Binding UseCategoryFolders}" />
                    <CheckBox Content="Watch the clipboard for download links" IsChecked="{Binding MonitorClipboard}" />
                    <CheckBox Content="Keep running in the system tray when the window is closed" IsChecked="{Binding MinimizeToTray}" />
                    <CheckBox Content="Show the progress window when a download starts" IsChecked="{Binding ShowProgressWindow}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Connection">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Connections per download (1–32)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding DefaultConnections}" />
                    <TextBlock Grid.Row="1" Text="Downloads at once in the queue" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding MaxSimultaneousDownloads}" />
                    <TextBlock Grid.Row="2" Text="Retries before giving up" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding MaxRetries}" />
                    <CheckBox Grid.Row="3" Content="Limit total speed to (KB/s)" IsChecked="{Binding SpeedLimitEnabled}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,10" Text="{Binding SpeedLimitKBps}" />
                    <TextBlock Grid.Row="4" Text="User agent" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Text="{Binding UserAgent}" />
                </Grid>
            </TabItem>

            <TabItem Header="Browser">
                <StackPanel>
                    <CheckBox Content="Accept downloads from the VeloDM browser extension" IsChecked="{Binding BrowserIntegration}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Local port" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="80" Text="{Binding BrowserPort}" />
                        <TextBlock Text="(the extension popup must use the same port)" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="Ask before starting a download captured from the browser" IsChecked="{Binding ShowDialogForBrowserDownloads}" />
                    <TextBlock Text="Capture these file types from the browser and clipboard:" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                    <TextBox Text="{Binding CaptureExtensions}" TextWrapping="Wrap" AcceptsReturn="True" Height="110"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Scheduler">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Start the queue daily at" IsChecked="{Binding ScheduleStartEnabled}" Width="190" />
                        <TextBox Width="70" Text="{Binding ScheduleStartTime}" Margin="0,0,0,10" VerticalAlignment="Top" />
                        <TextBlock Text="HH:mm" Foreground="{StaticResource MutedBrush}" Margin="8,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Stop the queue daily at" IsChecked="{Binding ScheduleStopEnabled}" Width="190" />
                        <TextBox Width="70" Text="{Binding ScheduleStopTime}" Margin="0,0,0,10" VerticalAlignment="Top" />
                        <TextBlock Text="HH:mm" Foreground="{StaticResource MutedBrush}" Margin="8,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="When the queue finishes" Style="{StaticResource FieldLabel}" Width="190" />
                        <ComboBox x:Name="AfterQueueBox" Width="170" SelectedItem="{Binding AfterQueue}" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               Text="Use “Download Later” or “Add to queue” to put downloads in the queue. VeloDM has to be running (it can sit in the tray) for the schedule to fire." />
                </StackPanel>
            </TabItem>

            <TabItem Header="BitTorrent">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Listening port" Style="{StaticResource FieldLabel}" Width="150" />
                        <TextBox Width="80" Text="{Binding TorrentPort}" />
                    </StackPanel>
                    <CheckBox Content="Find peers with DHT (needed for most magnet links)" IsChecked="{Binding TorrentDht}" />
                    <CheckBox Content="Open the port on my router automatically (UPnP / NAT-PMP)" IsChecked="{Binding TorrentPortForwarding}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Upload limit (KB/s, 0 = none)" Style="{StaticResource FieldLabel}" Width="150" />
                        <TextBox Width="80" Text="{Binding TorrentUploadLimitKBps}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Keep seeding after download until ratio" IsChecked="{Binding SeedAfterDownload}" Width="250" />
                        <TextBox Width="60" Text="{Binding SeedRatioLimit}" Margin="0,0,0,10" VerticalAlignment="Top" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"
                               Text="The download speed limit also applies to torrents. Port changes apply the next time VeloDM starts a torrent." />
                    <Button Content="Open magnet links and .torrent files with VeloDM" HorizontalAlignment="Left" Padding="10,4"
                            Click="Associate_Click" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
