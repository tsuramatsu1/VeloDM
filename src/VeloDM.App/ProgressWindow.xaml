<Window x:Class="VeloDM.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VeloDM.App"
        Width="600" Height="500" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="UpdateToolsButton" Content="_Update video tools and retry" Style="{DynamicResource DialogButton}"
                    Click="UpdateTools_Click" Visibility="Collapsed"
                    ToolTip="Video sites change often. Downloading the newest video tools is the usual fix when a video fails." />
            <Button x:Name="OpenButton" Content="_Open" Style="{DynamicResource DialogButton}" Click="Open_Click" Visibility="Collapsed" />
            <Button Content="Open _folder" Style="{DynamicResource DialogButton}" Click="OpenFolder_Click" />
            <Button x:Name="PauseButton" Content="_Pause" Style="{DynamicResource DialogButton}" Click="PauseResume_Click" />
            <Button Content="_Close" Style="{DynamicResource DialogButton}" IsCancel="True" Click="Close_Click" />
        </StackPanel>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                    <Setter Property="Margin" Value="0,0,14,6" />
                </Style>
                <Style x:Key="Value" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="File" />
            <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FileName}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Address" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Url}" ToolTip="{Binding Url}" />
            <TextBlock Grid.Row="2" Text="Status" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding StatusText}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Text="File size" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SizeText}" />
            <TextBlock Grid.Row="4" Text="Downloaded" />
            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DownloadedText}" />
            <TextBlock Grid.Row="5" Text="Transfer rate" />
            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}">
                <Run Text="{Binding SpeedText, Mode=OneWay}" /><Run Text="     Time left: " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding EtaText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Grid.Row="6" Text="Resume capability" />
            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ResumeText}" />
            <TextBlock x:Name="PeersLabel" Grid.Row="7" Text="Seeds / peers" />
            <TextBlock x:Name="PeersValue" Grid.Row="7" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ConnectionsText}" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" Height="18" Margin="0,8,0,6" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                     BorderThickness="0" />
        <local:SegmentBar x:Name="SegBar" DockPanel.Dock="Top" Height="14" Margin="0,0,0,10"
                          ToolTip="HTTP: each block is a range of the file and dark marks are live connections. Torrent: pieces you already have." />

        <Grid>
        <ListView x:Name="FilesList" BorderBrush="{DynamicResource BorderBrush}" Visibility="Collapsed">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File (untick to skip)" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Wanted, Mode=TwoWay}" Content="{Binding Path}" ToolTip="{Binding Path}"
                                          Click="FileWanted_Click" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Done" Width="70" DisplayMemberBinding="{Binding PercentText}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock x:Name="DetailNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top"
                   Margin="2,6,2,0" Visibility="Collapsed" />
        <ListView x:Name="ConnectionList" BorderBrush="{DynamicResource BorderBrush}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="N." Width="40" DisplayMemberBinding="{Binding Index}" />
                    <GridViewColumn Header="Start" Width="110" DisplayMemberBinding="{Binding StartText}" />
                    <GridViewColumn Header="End" Width="110" DisplayMemberBinding="{Binding EndText}" />
                    <GridViewColumn Header="Downloaded" Width="110" DisplayMemberBinding="{Binding DownloadedText}" />
                    <GridViewColumn Header="Info" Width="140" DisplayMemberBinding="{Binding State}" />
                </GridView>
            </ListView.View>
        </ListView>
        </Grid>
    </DockPanel>
</Window>
