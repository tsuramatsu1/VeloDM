{
  "manifest_version": 3,
  "name": "VeloDM Integration",
  "version": "1.5.1",
  "description": "Hands browser downloads, magnet links and playing videos to the VeloDM download manager.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://*.facebook.com/*"],
      "js": ["page-hook.js"], "world": "MAIN", "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "VeloDM",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
