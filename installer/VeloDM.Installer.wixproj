<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Built by installer/build.ps1, which publishes the app into installer/publish first. -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <OutputName>VeloDM-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(MSBuildProjectDirectory)\publish</DefineConstants>
    <OutputPath>output\</OutputPath>
    <SuppressPdbOutput>true</SuppressPdbOutput>
  </PropertyGroup>

</Project>
